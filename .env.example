# ──────────────────────────────────────────────
# Unwrap — Environment Configuration
# Copy this file to .env and adjust as needed.
# ──────────────────────────────────────────────

# Fuzzy-match threshold (0–100) for ingredient name matching
# FUZZY_MATCH_THRESHOLD=92

# Enable LLM-based ingredient picking when fuzzy match fails
# LLM_PICK_ENABLED=False

# VLM (Vision-Language Model) backend: "local" or "remote"
# VLM_BACKEND=local

# Base URL for the VLM inference server
# VLM_BASE_URL=http://localhost:8080/v1

# Model name for VLM inference
# VLM_MODEL_NAME=mlx-community/Qwen2.5-VL-7B-Instruct-4bit

# xAI Grok API Configuration (OpenAI-compatible)
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxx
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest
# GROK_RPM_LIMIT=30
# GROK_DAILY_CAP=100

# Chat / Card generation backend: "xai", "local", "gemini", or "groq"
# CHAT_BACKEND=xai

# API key for Google Gemini (optional fallback)
# GEMINI_API_KEY=

# API key for Groq (optional fallback)
# GROQ_API_KEY=

# Timeout in seconds for VLM requests
# VLM_TIMEOUT_SECONDS=60

# Enable debug mode (verbose logging, extra diagnostics)
# DEBUG_MODE=False
